#   Root-Level .gitignore
#   Society Management System (MERN)

# Node Modules (Frontend + Backend)
node_modules/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
**/.env
**/.env.*

# Build Artifacts
dist/
build/
.cache/
.temp/

# Uploads Folder (Backend)
society-backend/uploads/

# OS / Editor System Files
.DS_Store
Thumbs.db
desktop.ini

# VS Code Folder
.vscode/
sftp.json

# Logs generated by MongoDB or processes
*.log
mongodb-*.log

# Python / ML Files (if any)
*.pyc
__pycache__/

# Cache files
*.cache
